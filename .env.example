# PLACEHOLDER 1 (recommended) - Semantic Scholar API key.
# Replace the text after the = sign with your key.
# Get a free key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=PASTE_YOUR_SEMANTIC_SCHOLAR_KEY_HERE

# PLACEHOLDER 2 (optional) - an email address you are happy to share with OpenAlex.
# OpenAlex serves identified ("polite") users faster. Leave as-is to skip.
OPENALEX_EMAIL=